# Copy to articles/.env (git ignores it) and fill in. The data skills read the environment first,
# then the nearest .env: the working folder, articles/, then the repository root.

# fetch-fred: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# fetch-ecos: https://ecos.bok.or.kr/api/ (인증키 신청); ECOS_API_KEY is also accepted
BOK_API_KEY=

# Where fetch-ecos keeps its table and item index (default ~/.cache/datasteg-articles)
# ARTICLES_CACHE=/data/articles/cache
