{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "cover",
 "description": "cover/cover.json, the record of make-cover (guides/covers.md). The picture itself is cover/cover.svg.",
 "type": "object",
 "required": [
  "concept",
  "alt",
  "considered",
  "chosen",
  "rounds"
 ],
 "properties": {
  "concept": {
   "type": "object",
   "required": [
    "en",
    "ko"
   ],
   "properties": {
    "en": {
     "type": "string",
     "minLength": 1
    },
    "ko": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "alt": {
   "type": "object",
   "required": [
    "en",
    "ko"
   ],
   "properties": {
    "en": {
     "type": "string",
     "minLength": 1,
     "maxLength": 125
    },
    "ko": {
     "type": "string",
     "minLength": 1,
     "maxLength": 125
    }
   }
  },
  "considered": {
   "type": "array",
   "minItems": 3,
   "items": {
    "type": "object",
    "required": [
     "kind",
     "idea",
     "verdict"
    ],
    "properties": {
     "kind": {
      "enum": [
       "object",
       "mechanism",
       "data"
      ]
     },
     "idea": {
      "type": "string",
      "minLength": 1
     },
     "verdict": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "chosen": {
   "enum": [
    "object",
    "mechanism",
    "data"
   ]
  },
  "rounds": {
   "type": "integer",
   "minimum": 0,
   "maximum": 6
  },
  "checked": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}
