{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "themes",
 "type": "object",
 "properties": {
  "period": {
   "type": "object",
   "properties": {
    "from": {
     "type": "string",
     "minLength": 1
    },
    "to": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "from",
    "to"
   ]
  },
  "speeches": {
   "type": "integer",
   "minimum": 1
  },
  "themes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "label": {
      "type": "object",
      "properties": {
       "en": {
        "type": "string",
        "minLength": 1
       },
       "ko": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "en"
      ]
     },
     "summary": {
      "type": "string",
      "minLength": 1
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 2
     },
     "speakers": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1
     },
     "disagreement": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id",
     "label",
     "summary",
     "evidence",
     "speakers"
    ]
   },
   "minItems": 3
  }
 },
 "required": [
  "period",
  "speeches",
  "themes"
 ]
}
