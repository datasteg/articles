{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "make-slides record: what was rendered, looked at and fixed (slides/slides.json)",
  "type": "object",
  "required": ["rounds", "checked", "for_editor"],
  "additionalProperties": false,
  "properties": {
    "rounds": {"type": "integer", "minimum": 1, "maximum": 4},
    "checked": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "accepted": {
      "type": "array",
      "items": {
        "type": "object", "required": ["frame", "reason"], "additionalProperties": false,
        "properties": {"frame": {"type": "string", "description": "A key of slides/render.json → problems, e.g. 'en s05·2'"},
                       "reason": {"type": "string", "minLength": 8}}
      }
    },
    "for_editor": {"type": "array", "items": {"type": "string"}}
  }
}
