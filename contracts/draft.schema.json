{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "draft",
 "type": "object",
 "properties": {
  "kicker": {
   "type": "string",
   "minLength": 1
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "dek": {
   "type": "string",
   "minLength": 1
  },
  "byline": {
   "type": "string"
  },
  "keyNumbers": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "value": {
      "type": "string",
      "minLength": 1
     },
     "label": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "value",
     "label"
    ],
    "additionalProperties": true
   },
   "minItems": 0
  },
  "findings": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 3
  },
  "question": {
   "type": "object",
   "properties": {
    "asked": {
     "type": "string",
     "minLength": 1
    },
    "lookedAt": {
     "type": "string",
     "minLength": 1
    },
    "premiseNote": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "asked",
    "lookedAt"
   ],
   "additionalProperties": true
  },
  "sections": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "heading": {
      "type": "string",
      "minLength": 1
     },
     "blocks": {
      "type": "array",
      "items": {
       "type": "object"
      },
      "minItems": 1
     },
     "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "description": "One short plain sentence on what the section shows, for the article's contents list (no marks or citations)."
     }
    },
    "required": [
     "id",
     "heading",
     "blocks"
    ],
    "additionalProperties": true
   },
   "minItems": 3
  },
  "insight": {
   "type": "object",
   "properties": {
    "label": {
     "type": "string",
     "minLength": 1
    },
    "text": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "label",
    "text"
   ],
   "additionalProperties": true
  },
  "disclaimer": {
   "type": "string",
   "minLength": 1
  },
  "citations": {
   "type": "object"
  }
 },
 "required": [
  "kicker",
  "title",
  "dek",
  "findings",
  "question",
  "sections",
  "insight",
  "citations"
 ],
 "additionalProperties": true
}
