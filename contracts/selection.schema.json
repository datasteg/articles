{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "selection",
 "type": "object",
 "properties": {
  "as_of": {
   "type": "string",
   "minLength": 1
  },
  "window": {
   "type": "string",
   "minLength": 1
  },
  "candidates": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "doc": {
      "type": "string",
      "minLength": 1
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "institution": {
      "type": "string",
      "minLength": 1
     },
     "date": {
      "type": "string",
      "minLength": 1
     },
     "score": {
      "type": "number"
     },
     "why": {
      "type": "string",
      "minLength": 1
     },
     "against": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "doc",
     "title",
     "why"
    ]
   },
   "minItems": 3
  },
  "chosen": {
   "type": "object",
   "properties": {
    "doc": {
     "type": "string",
     "minLength": 1
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "why_readers": {
     "type": "string",
     "minLength": 1
    },
    "method_check": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "doc",
    "title",
    "why_readers",
    "method_check"
   ]
  }
 },
 "required": [
  "as_of",
  "candidates",
  "chosen"
 ]
}
